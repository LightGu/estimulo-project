NODE_ENV=development

# API HTTP
PORT=3000
# Login do painel: usuario/senha ficam na tabela app_users (Supabase), gerenciada
# via `npm run users:manage -- create <usuario> <senha>`. Duracao da sessao (cookie
# HttpOnly) e onde o backend persiste as sessoes ativas entre restarts:
ESTIMULO_SESSION_TTL_HOURS=168
ESTIMULO_SESSION_STATE_FILE=storage/sessions.json
# Fuso padrao do processo. Serve de fallback para as janelas de disparo e para a
# data usada na geracao de legenda quando o valor especifico nao esta definido.
TZ=America/Bahia

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis-local
REDIS_DB=0

# Evolution API / WhatsApp test integration
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=estimulo-mvp
EVOLUTION_API_TIMEOUT_MS=15000
EVOLUTION_API_MEDIA_TIMEOUT_MS=180000
# Limite de corpo aceito pela Evolution API (express.json({ limit: '136mb' }), valor
# fixo no bundle dela). Midia vai em base64, +33% sobre o arquivo, entao video acima
# de ~102 MB estoura esse limite e volta HTTP 413.
EVOLUTION_API_MAX_MEDIA_PAYLOAD_BYTES=142606336
# false desliga a recompressao automatica de video acima do limite: o envio passa a
# falhar com 413 em vez de reduzir o arquivo antes de enviar.
EVOLUTION_MEDIA_COMPRESSION_ENABLED=true
EVOLUTION_API_PORT=8080
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:latest
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution-local
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_PORT=5433
# Host do Postgres da Evolution visto pela aplicacao. Dentro do Compose a API usa
# `evolution-postgres:5432`; a aplicacao Node roda fora e alcanca pela porta
# publicada acima.
EVOLUTION_DB_HOST=localhost
# Alternativa as quatro variaveis acima quando a Evolution e gerenciada e so
# fornece uma URL de conexao.
# EVOLUTION_DB_URL=postgresql://usuario:senha@host:5432/evolution

# Confirmacao de entrega: le o ACK da mensagem (SERVER_ACK/DELIVERY_ACK/READ) no
# banco da Evolution (variaveis EVOLUTION_DB_* acima), porque a rota
# /chat/findMessages da v2.3.7 nao expoe esse campo. Serve para o relatorio nao
# registrar como entregue tudo que a Evolution apenas aceitou.
#
# Atencao ao alcance disso: o WhatsApp NAO devolve ACK de mensagem enviada a
# grupo. Todas ficam em PENDING para sempre e nenhuma gera linha em MessageUpdate
# (medido na instancia real). Entao, para grupo, a ausencia de ACK nao reprova o
# envio - o log fica "enviado" com provider_status=SEM_ACK_DE_GRUPO e o relatorio
# mostra isso como selo de confirmacao proprio. Recusa explicita da Evolution e
# ACK de erro continuam reprovando em qualquer destino.
# DELIVERY_CONFIRMATION_ENABLED=false desliga a leitura do ACK por completo.
DELIVERY_CONFIRMATION_ENABLED=true
DELIVERY_CONFIRMATION_TIMEOUT_MS=90000
# Janela curta usada quando o destino e grupo: nao ha ACK para esperar, so vale
# dar tempo de a Evolution persistir a mensagem e de um ACK de erro aparecer.
DELIVERY_CONFIRMATION_GROUP_TIMEOUT_MS=15000
DELIVERY_CONFIRMATION_POLL_INTERVAL_MS=5000

# Notificacoes externas (avisos de campanha/falha/erro de IA no grupo escolhido
# na tela de Configuracoes). Deixe vazio para o padrao: liga em execucao normal e
# desliga sozinho quando o processo e um teste (NODE_ENV=test ou entrypoint
# tests/*.test.js). NOTIFICATIONS_ENABLED=false forca dry-run; =true forca envio.
NOTIFICATIONS_ENABLED=

GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_VIDEO_INDEX_STATE_FILE=storage/google-drive-video-index-state.json
# GOOGLE_DRIVE_VIDEO_INDEX_CRON/TIMEZONE abaixo sao usados apenas como valor inicial (seed) do
# worker antes da primeira configuracao pela tela de Configuracoes. Depois que o usuario salvar
# um horario pela UI, a tabela `settings` (colunas drive_index_cron/drive_index_timezone) passa
# a ser a fonte de verdade e sobrescreve estas variaveis.
GOOGLE_DRIVE_VIDEO_INDEX_CRON=0 3 * * *
GOOGLE_DRIVE_VIDEO_INDEX_TIMEZONE=America/Bahia

# Gemini video caption/transcription
GEMINI_API_KEY=
# Alternativa aceita pelo adapter quando GEMINI_API_KEY nao esta definida
# GOOGLE_AI_API_KEY=
# Nem todo modelo listado pela API esta de fato disponivel para a chave gratuita
# (pode dar 404 "no longer available to new users" ou 429 com quota 0, mesmo aparecendo
# em GET /v1beta/models). Antes de configurar, valide com uma chamada real de generateContent.
# Modelo/fallbacks padrao (usados quando a tela de Configuracoes ainda nao foi
# salva); depois de salvar pela UI, a tabela `settings` (coluna ai_agents) passa
# a ser a fonte de verdade por agente (transcricao, geracao de legenda, revisao).
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIPTION_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-flash-latest,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_TEXT_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest

VIDEO_TRANSCRIPTION_PROMPT=

# O agente de transcricao envia para o Gemini apenas o audio extraido do video
# (mono/16 kHz/mp3), nao o video: reduz de ~258 para ~32 tokens por segundo de
# midia e encolhe o upload. A extracao usa o ffmpeg instalado via npm
# (@ffmpeg-installer/ffmpeg); FFMPEG_PATH sobrescreve o binario usado.
# TRANSCRIPTION_AUDIO_ONLY=false volta a enviar o video (fallback de emergencia).
# TRANSCRIPTION_AUDIO_ONLY=true
# FFMPEG_PATH=

GROUP_SYNC_ORGANIZATION_ID=
GROUP_SYNC_DEFAULT_MATURIDADE=1
GROUP_SYNC_CRON=0 2 * * *
GROUP_SYNC_TIMEZONE=America/Bahia

# Disparo e timeouts. Todas opcionais: o valor comentado e o default do codigo.
# A janela e o intervalo de campanha vem da tabela `settings` / do payload da
# campanha; estas variaveis so entram como fallback quando nada foi configurado.
CAMPAIGN_TIMEZONE=America/Bahia
# CAMPAIGN_DISPATCH_WINDOW_START=   # default: momento da execucao (ISO)
# CAMPAIGN_DISPATCH_WINDOW_END=     # default: fim da janela calculada (ISO)
# CAMPAIGN_DISPATCH_JITTER_MIN_MS=60000    # settings.min_interval_min, ou 60000
# CAMPAIGN_DISPATCH_JITTER_MAX_MS=300000   # settings.max_interval_min, ou 300000
# CAMPAIGN_TRIGGER_ENQUEUE_TIMEOUT_MS=5000
# DISPATCH_JOB_TIMEOUT_MS=1500000          # 25 min
# MENSAGENS_DISPATCH_JOB_TIMEOUT_MS=60000  # 1 min
# EVOLUTION_GROUP_SYNC_TIMEOUT_MS=180000   # 0 (sem timeout) quando busca participantes
# HEALTH_REDIS_TIMEOUT_MS=1000
# VIDEO_CAPTION_TIMEZONE=            # default: TZ, senao America/Bahia

# Supabase
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
