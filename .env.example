NODE_ENV=development

# API HTTP
PORT=3000
# Endereco em que o container publica a porta da API no host (docker-compose).
# 0.0.0.0 expoe para fora da VM; use 127.0.0.1 se houver proxy reverso na mesma maquina.
API_BIND_ADDRESS=0.0.0.0
# "loopback" (padrao) confia so em conexoes locais. Atras de proxy reverso (nginx,
# Cloudflare etc.) defina 1 (ou o numero de proxies) para o Express ler o IP real
# do cliente via X-Forwarded-For.
EXPRESS_TRUST_PROXY=loopback
# Lista separada por virgulas de origens autorizadas (sem barra final). Em producao,
# inclua a URL do frontend Vercel, por exemplo https://SEU-PROJETO.vercel.app.
CORS_ALLOWED_ORIGINS=
# Para frontend em outro dominio (Vercel), use "None" junto de HTTPS na API.
# Mantenha Lax para uso no mesmo site/ambiente local.
ESTIMULO_COOKIE_SAME_SITE=Lax
# Cookie Secure exige HTTPS - sem isso o navegador nunca guarda o cookie de
# sessao. Em NODE_ENV=production o padrao e' Secure=true (exige HTTPS). Defina
# "false" so para testar login por IP puro em HTTP antes de configurar
# dominio/TLS; volte a deixar vazio (ou "true") assim que houver HTTPS.
ESTIMULO_COOKIE_SECURE=
# Host publico usado pelo Caddy (perfil "proxy" do docker-compose) para emitir
# certificado HTTPS automatico via Let's Encrypt. Pode ser um dominio proprio
# ou, sem custo, um host tipo <ip-com-hifens>.sslip.io (ex.: para o IP
# 163.176.107.172, use 163-176-107-172.sslip.io) - va em
# docs/DEPLOY_ORACLE.md#https-sem-dominio-proprio para o passo a passo.
ESTIMULO_PUBLIC_HOSTNAME=
# Login do painel: usuario/senha ficam na tabela app_users (Supabase), gerenciada
# via `npm run users:manage -- create <usuario> <senha>` ou pela aba "Usuarios do
# painel" em Configuracoes. Duracao da sessao (cookie HttpOnly) e onde o backend
# persiste as sessoes ativas entre restarts:
ESTIMULO_SESSION_TTL_HOURS=168
ESTIMULO_SESSION_STATE_FILE=storage/sessions.json
# Fuso padrao do processo. Serve de fallback para as janelas de disparo e para a
# data usada na geracao de legenda quando o valor especifico nao esta definido.
TZ=America/Bahia

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis-local
REDIS_DB=0

# Evolution API / WhatsApp test integration
# ATENCAO: este valor vale para rodar a API FORA do Docker (`npm run api`).
# Dentro do compose, "localhost" e' o proprio container da aplicacao, entao o
# infra/docker-compose.yml sobrescreve esta variavel para
# http://evolution-api:8080 (o nome do servico na rede interna). Nao e' preciso
# mudar nada aqui; para apontar para uma Evolution externa a partir do Docker,
# use EVOLUTION_API_URL_INTERNAL.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
# URL publica da Evolution quando ela roda no mesmo host (perfil `evolution` do
# docker-compose): informa a propria API sua URL externa. So faz sentido se a
# Evolution tiver dominio/IP acessivel de fora; sem isso mantenha vazio.
EVOLUTION_PUBLIC_URL=
EVOLUTION_INSTANCE_NAME=estimulo-mvp
EVOLUTION_API_TIMEOUT_MS=15000
EVOLUTION_API_MEDIA_TIMEOUT_MS=180000
# Limite de corpo aceito pela Evolution API (express.json({ limit: '136mb' }), valor
# fixo no bundle dela). Midia vai em base64, +33% sobre o arquivo, entao video acima
# de ~102 MB estoura esse limite e volta HTTP 413.
EVOLUTION_API_MAX_MEDIA_PAYLOAD_BYTES=142606336
# false desliga a recompressao automatica de video acima do limite: o envio passa a
# falhar com 413 em vez de reduzir o arquivo antes de enviar.
EVOLUTION_MEDIA_COMPRESSION_ENABLED=true
# Disparador Pontual (anexo enviado direto na tela, sem passar por disco/banco).
# Teto do upload: video acima disto e recusado com 413; abaixo, e aceito e
# recomprimido automaticamente antes do envio. O arquivo fica em RAM durante o
# request (multer memoryStorage), entao subir muito acima exige conferir a
# memoria do container da API.
ADHOC_MEDIA_MAX_UPLOAD_BYTES=524288000
# Imagem nao passa pelo pipeline de compressao (o ffmpeg aqui e de video), entao
# tem um teto proprio, menor.
ADHOC_IMAGE_MAX_UPLOAD_BYTES=16777216
# Alvo de bytes crus do video DEPOIS da compressao. 16 MB e' o teto que o
# WhatsApp entrega como video inline sem recompactar sozinho, mas mirar nele
# forca bitrate baixo demais em videos com mais de ~1 min e a qualidade cai
# visivelmente. 64 MB mantem qualidade melhor (o WhatsApp pode recomprimir por
# conta propria acima de 16 MB, mas isso e preferivel a degradar tudo aqui).
ADHOC_VIDEO_TARGET_BYTES=67108864
EVOLUTION_API_PORT=8080
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:latest
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution-local
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_PORT=5433
# Host do Postgres da Evolution visto pela aplicacao.
#
# ATENCAO - este par de variaveis deixou a confirmacao de entrega inerte em
# producao por semanas. Dentro do Compose, "localhost" e o PROPRIO container e a
# porta 5433 nao existe (o servico evolution-postgres escuta em 5432 e nao
# publica porta), entao toda consulta de ACK falhava, o catch devolvia null e
# TODO envio era gravado com provider_status "NAO_VERIFICADO" - inclusive os que
# o WhatsApp marcou com ACK de erro. Rodando fora do Docker o valor abaixo esta
# correto; dentro do Compose, infra/docker-compose.yml agora injeta
# `evolution-postgres:5432` no bloco x-app, do mesmo jeito que ja fazia com
# EVOLUTION_API_URL. Os overrides EVOLUTION_DB_HOST_INTERNAL /
# EVOLUTION_DB_PORT_INTERNAL existem para quem usa uma Evolution externa.
EVOLUTION_DB_HOST=localhost
# Alternativa as quatro variaveis acima quando a Evolution e gerenciada e so
# fornece uma URL de conexao.
# EVOLUTION_DB_URL=postgresql://usuario:senha@host:5432/evolution

# Confirmacao de entrega: le o ACK da mensagem (SERVER_ACK/DELIVERY_ACK/READ) no
# banco da Evolution (variaveis EVOLUTION_DB_* acima), porque a rota
# /chat/findMessages da v2.3.7 nao expoe esse campo. Serve para o relatorio nao
# registrar como entregue tudo que a Evolution apenas aceitou.
#
# Atencao ao alcance disso: o WhatsApp NAO devolve ACK de mensagem enviada a
# grupo. Todas ficam em PENDING para sempre e nenhuma gera linha em MessageUpdate
# (medido na instancia real). Entao, para grupo, a ausencia de ACK nao reprova o
# envio - o log fica "enviado" com provider_status=SEM_ACK_DE_GRUPO e o relatorio
# mostra isso como selo de confirmacao proprio. Recusa explicita da Evolution e
# ACK de erro continuam reprovando em qualquer destino.
# DELIVERY_CONFIRMATION_ENABLED=false desliga a leitura do ACK por completo.
DELIVERY_CONFIRMATION_ENABLED=true
DELIVERY_CONFIRMATION_TIMEOUT_MS=90000
# Janela curta usada quando o destino e grupo: nao ha ACK para esperar, so vale
# dar tempo de a Evolution persistir a mensagem e de um ACK de erro aparecer.
DELIVERY_CONFIRMATION_GROUP_TIMEOUT_MS=5000
DELIVERY_CONFIRMATION_POLL_INTERVAL_MS=5000

# Notificacoes externas (avisos de campanha/falha/erro de IA no grupo escolhido
# na tela de Configuracoes). Deixe vazio para o padrao: liga em execucao normal e
# desliga sozinho quando o processo e um teste (NODE_ENV=test ou entrypoint
# tests/*.test.js). NOTIFICATIONS_ENABLED=false forca dry-run; =true forca envio.
NOTIFICATIONS_ENABLED=

GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_VIDEO_INDEX_STATE_FILE=storage/google-drive-video-index-state.json
# GOOGLE_DRIVE_VIDEO_INDEX_CRON/TIMEZONE abaixo sao usados apenas como valor inicial (seed) do
# worker antes da primeira configuracao pela tela de Configuracoes. Depois que o usuario salvar
# um horario pela UI, a tabela `settings` (colunas drive_index_cron/drive_index_timezone) passa
# a ser a fonte de verdade e sobrescreve estas variaveis.
GOOGLE_DRIVE_VIDEO_INDEX_CRON=0 3 * * *
GOOGLE_DRIVE_VIDEO_INDEX_TIMEZONE=America/Bahia

# Gemini video caption/transcription
GEMINI_API_KEY=
# Alternativa aceita pelo adapter quando GEMINI_API_KEY nao esta definida
# GOOGLE_AI_API_KEY=
# Nem todo modelo listado pela API esta de fato disponivel para a chave gratuita
# (pode dar 404 "no longer available to new users" ou 429 com quota 0, mesmo aparecendo
# em GET /v1beta/models). Antes de configurar, valide com uma chamada real de generateContent.
# Modelo/fallbacks padrao (usados quando a tela de Configuracoes ainda nao foi
# salva); depois de salvar pela UI, a tabela `settings` (coluna ai_agents) passa
# a ser a fonte de verdade por agente (transcricao, geracao de legenda, revisao).
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIPTION_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-flash-latest,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_TEXT_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest

VIDEO_TRANSCRIPTION_PROMPT=

# O agente de transcricao envia para o Gemini apenas o audio extraido do video
# (mono/16 kHz/mp3), nao o video: reduz de ~258 para ~32 tokens por segundo de
# midia e encolhe o upload. A extracao usa o ffmpeg instalado via npm
# (@ffmpeg-installer/ffmpeg); FFMPEG_PATH sobrescreve o binario usado.
# TRANSCRIPTION_AUDIO_ONLY=false volta a enviar o video (fallback de emergencia).
# TRANSCRIPTION_AUDIO_ONLY=true
# FFMPEG_PATH=

GROUP_SYNC_ORGANIZATION_ID=
GROUP_SYNC_DEFAULT_MATURIDADE=1
GROUP_SYNC_CRON=0 2 * * *
GROUP_SYNC_TIMEZONE=America/Bahia

# Disparo e timeouts. Todas opcionais: o valor comentado e o default do codigo.
# A janela e o intervalo de campanha vem da tabela `settings` / do payload da
# campanha; estas variaveis so entram como fallback quando nada foi configurado.
CAMPAIGN_TIMEZONE=America/Bahia
# CAMPAIGN_DISPATCH_WINDOW_START=   # default: momento da execucao (ISO)
# CAMPAIGN_DISPATCH_WINDOW_END=     # default: fim da janela calculada (ISO)
# CAMPAIGN_DISPATCH_JITTER_MIN_MS=60000    # settings.min_interval_min, ou 60000
# CAMPAIGN_DISPATCH_JITTER_MAX_MS=300000   # settings.max_interval_min, ou 300000
# CAMPAIGN_TRIGGER_ENQUEUE_TIMEOUT_MS=5000
# DISPATCH_JOB_TIMEOUT_MS=1500000          # 25 min
# MENSAGENS_DISPATCH_JOB_TIMEOUT_MS=60000  # 1 min

# Travas de atraso (anti-reenvio no boot). O Redis da infra persiste as filas
# (--appendonly yes + volume), entao ao subir os workers a BullMQ promove de uma
# vez todo job vencido. Um envio atrasado mais que estes tetos e CANCELADO em vez
# de sair para o grupo. Aumentar demais reabre o risco de spam; diminuir demais
# cancela envio legitimo de campanha grande (o worker de video roda serial).
# Os tetos abaixo so valem para envio SEM janela (disparo imediato/teste) ou
# depois que a janela escolhida terminou: enquanto o horario de fim da janela nao
# chega, entregar continua sendo o que o usuario pediu, e a fila ter atrasado nao
# muda isso. Ver a regra de janela em src/services/dispatch-staleness.js.
# MAX_DISPATCH_DELAY_MS=1800000            # 30 min  - mensagem pontual
# MAX_VIDEO_DISPATCH_DELAY_MS=21600000     # 6 h     - campanha de video
# Teto ABSOLUTO, valido inclusive dentro da janela: impede que uma janela mal
# preenchida (fim daqui a uma semana) reabra o replay de boot que a trava barra.
# MAX_ABSOLUTE_DISPATCH_DELAY_MS=86400000  # 24 h
# Teto de idade para a confirmacao automatica por timeout de revisao: campanha
# abandonada em "gerando_legendas" mais velha que isto exige acao manual, para
# nao ser ressuscitada e disparada inteira a cada boot.
# MAX_AUTO_CONFIRM_AGE_MS=86400000         # 24 h
# EVOLUTION_GROUP_SYNC_TIMEOUT_MS=180000   # 0 (sem timeout) quando busca participantes
# HEALTH_REDIS_TIMEOUT_MS=1000
# VIDEO_CAPTION_TIMEZONE=            # default: TZ, senao America/Bahia

# Lidas pelo codigo mas que faltavam aqui. Todas opcionais - os valores abaixo
# sao os defaults efetivos, deixe comentado para usar o default.
# Antecedencia com que a campanha e' confirmada antes da janela de disparo.
# CAMPAIGN_DISPATCH_CONFIRM_LEAD_MS=300000   # 5 min
# "true" faz a revisao de legenda reprovar no primeiro problema em vez de
# apenas sinalizar; deixe em false salvo para depurar o revisor.
# CAPTION_REVIEW_STRICT=false
# Banco Redis usado pelos testes de integracao, para nao encostar no de trabalho.
# REDIS_TEST_DB=15
# Depuracao de logs de disparo orfaos (sem campanha/grupo correspondente).
# Ligue apenas para investigar; grava um arquivo de trace a cada ocorrencia.
# TRACE_ORPHAN_DISPATCH_LOGS=0               # "1" liga
# TRACE_ORPHAN_DISPATCH_LOGS_FILE=

# Supabase
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

# Sentry (rastreamento de erros): vazio = totalmente desligado, tanto na API/
# workers quanto no painel (GET /config/sentry so libera o DSN pro navegador
# quando isto estiver preenchido). O mesmo DSN serve para backend e frontend -
# um projeto Sentry aceita eventos dos dois SDKs (Node e Browser) e os separa
# por tag "platform". Crie o projeto em https://sentry.io (plano free cobre
# esse uso) e cole o DSN aqui. Veja docs/SENTRY.md para o passo a passo e onde
# ver os erros capturados.
SENTRY_DSN=
# Nome do ambiente mostrado no Sentry (filtro "Environment"). Vazio usa NODE_ENV.
SENTRY_ENVIRONMENT=
# Fracao de requisicoes com tracing de performance (0 a 1). 0 = so erros, sem
# tracing - suficiente para o objetivo de diagnostico e nao consome a cota
# separada (menor) de "Performance Units" do plano free.
SENTRY_TRACES_SAMPLE_RATE=0
# Session Replay (frontend): grava a tela do usuario (DOM, nao video/audio) para
# reconstituir os passos antes do erro. replaysSessionSampleRate e' a fracao de
# sessoes normais gravadas (0 = nenhuma, poupa a cota mensal de replays do
# free); replaysOnErrorSampleRate e' a fracao das sessoes QUE TIVERAM ERRO que
# ganham replay - 1 (100%) e' o que resolve "o usuario nao sabe descrever o que
# fez".
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

# --- Limites e caches acrescentados na auditoria de 07/09/2026 ---

# Envios simultaneos do disparo pontual sincrono (POST /mensagens/dispatch).
# Antes nao havia teto: Promise.all sobre a lista de grupos disparava N
# requisicoes concorrentes, cada uma serializando a mesma midia em base64 - pico
# de memoria multiplicado pelo numero de grupos, e uma rajada pelo mesmo numero,
# que e o padrao que o WhatsApp trata como spam.
ADHOC_DISPATCH_CONCURRENCY=2

# TTL do cache da linha unica de `settings` (ms). Ela era relida do Supabase em
# todo envio, todo sweep de retry, toda falha e toda notificacao. 0 desliga o
# cache. Toda escrita pela API invalida o cache local do processo, entao este TTL
# so atrasa a propagacao de uma mudanca para os OUTROS processos (os workers).
SETTINGS_CACHE_TTL_MS=30000

# Teto do tamanho do job serializado na fila de mensagens pontuais. O anexo
# deixou de viajar dentro do job (agora vai pelo spool - ver MEDIA_SPOOL_TTL_MS),
# entao este teto vale hoje como rede de seguranca contra payload absurdo: um job
# desta fila deveria ser de poucos KB. Jobs enfileirados antes dessa mudanca
# ainda carregam o base64 e continuam cobertos pelo limite generoso.
MENSAGENS_DISPATCH_JOB_SIZE_LIMIT_BYTES=209715200

# Timeout das checagens de banco no GET /health. O health check passou a olhar
# tambem o Supabase (essencial: 503) e o banco de ACK da Evolution (nao
# essencial: 200 "degraded"), em vez de apenas o Redis.
HEALTH_DATABASE_TIMEOUT_MS=2000

# --- Acrescentados ao concluir os itens pendentes da auditoria ---

# Tempo que o anexo do Disparador Pontual agendado fica no deposito temporario
# (ms). O anexo NAO viaja mais dentro do job da BullMQ: ele e' gravado uma vez,
# com esta expiracao, e apagado assim que o ultimo grupo do lote e' enviado.
#
# Antes, o base64 ia no payload de CADA job do lote e era reescrito a cada
# `job.updateData` do worker - um video de 100 MB para 30 grupos escrevia da
# ordem de 9 GB no Redis (que roda com appendonly) num unico disparo.
#
# O TTL e' a rede de seguranca para o lote que nunca chega a ser enviado
# (campanha cancelada, job removido a mao). Precisa cobrir o horizonte de
# agendamento: se expirar antes da hora do envio, o job FALHA com motivo
# registrado, em vez de mandar so o texto - ver src/services/media-spool.js.
MEDIA_SPOOL_TTL_MS=43200000

# Teto de espera por comando no Redis para as operacoes do deposito de anexo
# (ms). A conexao compartilhada do projeto usa `maxRetriesPerRequest: null`, o
# que faz o ioredis reenfileirar o comando INDEFINIDAMENTE enquanto o Redis nao
# responde. Sem este teto, um Redis fora do ar nao daria erro: daria espera
# eterna dentro do preparo do anexo, com os logs presos em "pendente" e a tela
# girando para sempre. Com o teto, a indisponibilidade vira falha visivel.
MEDIA_SPOOL_COMMAND_TIMEOUT_MS=10000

# Fila campaign-captions: a geracao de legendas da Etapa 2 deixou de ser uma
# promise solta no processo da api (onde todo deploy a abandonava no meio,
# deixando a campanha presa em "gerando_legendas") e virou um job com retry.
#
# Concorrencia 1 de proposito: a cota do Gemini e' um recurso global do projeto,
# nao por campanha - duas geracoes em paralelo nao terminam antes, so esgotam a
# cota mais cedo e fazem as duas falharem por 429.
CAMPAIGN_CAPTIONS_CONCURRENCY=1

# Tentativas do job de geracao de legendas. Retentar so e' seguro porque a
# geracao e' retomavel (preserva as linhas ja em "gerado"); a falha tipica aqui
# e' cota do Gemini, e o backoff comeca em 1 min.
CAMPAIGN_CAPTIONS_ATTEMPTS=3

# Lock do job de legendas (ms). A geracao percorre os grupos em serie e cada um
# pode baixar o video do Drive, extrair audio com ffmpeg, transcrever e chamar o
# Gemini; sem um lock longo a BullMQ consideraria o job travado e o reentregaria
# no meio da geracao.
CAMPAIGN_CAPTIONS_JOB_LOCK_MS=2700000
